<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Brixi</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Brixi</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Begin required section for Device Access Toolkit apps -->
	<!-- URL scheme so Meta AI can call back into this app after registration -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>brixi</string>
			</array>
		</dict>
	</array>

	<!-- Lets the SDK detect and open the Meta AI app via UIApplication.canOpenURL -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-viewapp</string>
	</array>

	<!-- DAT moves traffic over three link types and checks Info.plist before it
	     can use each one (see the SDK's getting-started guide). Bluetooth LE
	     alone, which is what this had before, is enough for registration and
	     presence, but not for camera streaming, which rides Bluetooth Classic
	     via the External Accessory framework: without
	     UISupportedExternalAccessoryProtocols declaring com.meta.ar.wearable,
	     iOS refuses that link outright, which DAT then reports up as "Device
	     is not connected" even though the glasses are paired and otherwise
	     show as active. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Needed to connect to Meta Wearables</string>
	<key>NSCameraUsageDescription</key>
	<string>Needed to identify LEGO pieces from your glasses' camera</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Needed to connect to your glasses' camera over Wi-Fi for part scanning.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>
	<!-- Add-only access for the debug "Save Captures" toggle (Settings),
	     which writes raw scan photos to Photos unmodified to check the
	     capture pipeline's actual resolution; see
	     docs/pile-mode-spec.md, Phase 0. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Needed to save scan photos for checking camera resolution.</string>

	<!-- Populated at build time from Brixi/Config/Secrets.xcconfig (gitignored;
	     see Brixi/Config/Secrets.example.xcconfig). Empty if that file doesn't exist. -->
	<key>RebrickableAPIKey</key>
	<string>$(REBRICKABLE_API_KEY)</string>

	<!-- Meta Wearables Device Access Toolkit configuration -->
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>brixi://</string>
		<!-- 0 = Developer Mode. Replace with your registered APPLICATION_ID for production
		     (see https://wearables.developer.meta.com/) -->
		<key>MetaAppID</key>
		<string>0</string>
	</dict>
	<!-- End required section for Device Access Toolkit apps -->

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
