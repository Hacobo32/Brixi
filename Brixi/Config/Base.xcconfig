//
// Base.xcconfig
//
// Set as the Brixi target's base configuration (Debug and Release) so
// Secrets.xcconfig -- gitignored, see Secrets.example.xcconfig -- can inject
// REBRICKABLE_API_KEY without that value ever being committed to git.
// #include? (with the ?) makes the include optional: the project still
// builds with an empty key if Secrets.xcconfig doesn't exist yet.

#include? "Secrets.xcconfig"

// MWDATMockDevice is only used under #if DEBUG, but the Swift package still
// links it into every configuration -- and it bundles its own copies of
// classes MWDATCamera also defines (SUPMediaStream*, FBValueObject, ...),
// so loading both triggers objc's "Class X is implemented in both" warning
// and risks failed casts in the glasses streaming path. Swift packages
// can't make a product dependency Debug-only, so instead have the linker
// drop any library Release code never references; with every MockDevice
// call compiled out, that removes it from the Release binary's load list.
OTHER_LDFLAGS[config=Release] = $(inherited) -Wl,-dead_strip_dylibs
